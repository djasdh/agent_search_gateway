# agent_search_gateway —— compose 环境变量示例
# 用法：cp .env.example .env  然后填入真实值。.env 已被 .gitignore 忽略，勿入库。
#
# 这些变量经 compose 注入容器（不写进任何镜像/仓库文件）。
#   - exaapi     读 EXA_API_KEY（searxng 引擎）
#   - tavily     读 TAVILY_API_KEY
#   - zhihu      读 ZHIHU_ACCESS_SECRET
#   - gateway    读 GATEWAY_TOKEN / EMBEDDING_API_KEY / SAUCENAO_API_KEY /
#                BILIBILI_HTTP_TOKEN / BROWSER_PROXY_PASSWORD
# 任一为空时对应能力自动降级（exaapi/tavily/zhihu 引擎会在 init 失败后被跳过；
# saucenao 未配 key 时该图源跳过）。

# --- 搜索引擎密钥 ---
EXA_API_KEY=
TAVILY_API_KEY=
ZHIHU_ACCESS_SECRET=

# --- 语义召回（embedding）密钥 ---
EMBEDDING_API_KEY=

# --- 网关鉴权（留空 = 不认证）---
GATEWAY_TOKEN=

# --- 以图搜图附加源（可选；留空 = 该源不启用）---
SAUCENAO_API_KEY=

# --- Bilibili HTTP 后端 Bearer（可选）---
BILIBILI_HTTP_TOKEN=

# --- 浏览器代理密码（可选；用户名在 gateway.docker.yaml）---
BROWSER_PROXY_PASSWORD=

# --- searxng server.secret_key（留空则容器启动时随机生成）---
SEARXNG_SECRET_KEY=

# --- 时区 ---
TZ=Asia/Shanghai
