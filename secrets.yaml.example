# agent_search_gateway 密钥（secrets.yaml）
#
# 复制为 secrets.yaml 使用，并限制权限：
#   chmod 600 secrets.yaml
#
# 这个文件只放敏感值；结构路径与 gateway.yaml 对应。
# 环境变量优先级最高（空环境变量视为未设置）：
#   GATEWAY_TOKEN / EMBEDDING_API_KEY / SAUCENAO_API_KEY /
#   BILIBILI_HTTP_TOKEN / BROWSER_PROXY_PASSWORD
#
# secrets.yaml 与 gateway.yaml 默认同目录；可用 GATEWAY_SECRETS_FILE 覆盖路径。

gateway:
  # MCP HTTP Bearer token。留空 = 不认证。
  token: ""

embedding:
  # embedding 服务凭据（provider 需要鉴权时填写）。
  api_key: ""

search:
  reverse_image:
    saucenao:
      # SauceNAO API key；为空 = 该源不启用。
      api_key: ""

bilibili:
  http:
    # 与 Bilibili HTTP 后端约定的 Bearer token。
    token: ""

browser:
  # 浏览器代理密码（proxy_username 在 gateway.yaml 的 browser 段）。
  proxy_password: ""
