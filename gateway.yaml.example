# agent_search_gateway 网关配置（整体 yaml）
# 复制为 gateway.yaml 使用。token 建议用环境变量 GATEWAY_TOKEN 注入，避免写文件。

gateway:
  host: 127.0.0.1
  port: 3000
  # token 请勿写在此文件（会提交到仓库）。用环境变量 GATEWAY_TOKEN 注入：
  #   export GATEWAY_TOKEN=your-secret
  # 留空 = 不认证；设置了 env GATEWAY_TOKEN 会优先于此处。
  token: ""

logging:
  level: info          # debug | info | warn | error
  file: ""             # 空=输出到 stdout，否则写文件

searxng:
  url: http://127.0.0.1:8888
  timeout_ms: 10000

flaresolverr:
  url: http://127.0.0.1:8192
  enabled: true            # 路由②（CF/JS 渲染）总开关
  timeout_ms: 60000        # FlareSolverr 请求超时
  max_concurrent: 2        # 并发信号量（保护浏览器资源）
  trigger_status: [403, 405, 429]   # direct 这些状态 → 升级 FlareSolverr
  fallback_on_empty: true  # direct 200 但空壳 JS → 升级

search:
  max_results: 10
  max_result_chars: 500
  cache_ttl_ms: 300000    # 5 分钟
  cache_max_entries: 200
  max_concurrent: 2       # 搜索并发信号量
  # 引擎分档：
  #   resident 每次查询都叠加（额度接近耗尽才移出）；rotating 按 fanout 轮换、失败静默换下一家。
  #   （也兼容旧写法：engines: [a, b, c] 平铺数组 == 全部轮换、resident 为空。）
  engines:
    resident: [zhihu, "zhihu web", bilibili]
    rotating: [exaapi, tavily, firecrawl]
  fanout_default: 1       # 默认扇出 1 家；选中引擎无结果/不可用时自动换下一家（仅作用于 rotating）
  # §9 配额台账（searxng quota 插件写入，网关消费）：
  #   剔除已耗尽引擎；fanout>1 时按剩余额度降序取前 N；整体余额紧张时扇出压回 1
  quota_enabled: true
  quota_ledger_path: ~/.config/agent-search/quota.json
  quota_tight_threshold: 0.1   # 候选引擎整体剩余占比低于该值 → 扇出压回 1
  resident_quota_floor: 0.2    # resident 引擎剩余占比低于该值 → 从常住档移出

rerank:
  enabled: true
  # 轻量重排层：绕过 searxng 的 category 分组排序，按「score × boost」降序重排，
  # 让被分组算法埋掉的高分结果（如带缩略图的 bilibili 视频）正常入场。
  # key 用 searxng 注册名（JSON engine 字段），非 settings.yml 的 name；
  # 默认 1.0，不配 = 按原始 score 排序。
  engine_boost:
    bilibili: 1.0
    "google cse": 1.0
    bing: 1.0
    duckduckgo: 1.0
    brave: 1.0
    wikipedia: 1.0
    github: 1.0
    stackoverflow: 1.0
    reddit: 1.0
    news: 1.0

  # 多样性重排层（语义向量就绪时生效；embedding/corpus 关闭则降级为引擎分顺序）：
  #   MMR 贪心去冗余 + 同注册域(eTLD+1)上限，压住「同一来源占满 top-k」。
  #   λ=1 → MMR 项失效，仅保留同域上限；先按综合分排序再按上限选择。
  diversity:
    enabled: true
    mmr_lambda: 1.0        # 0=全多样，1=全相关（λ=1 时 MMR 项失效，只剩同域上限）
    max_per_domain: 3      # 同一注册域最多几条

  # 权威重排层（语义向量就绪时生效）：最终分 = rel_norm + weight·auth。
  #   auth 按注册域/主机名的类别给分（gov/edu/官方文档≈0.95、可信大站≈0.7、UGC≈0.35、未知 0.5）。
  #   与 diversity 正交：关闭时行为严格等于纯 cosine 序。默认关闭。
  authority:
    enabled: true
    weight: 0.5            # 权威分权重；0=不生效

ad_filter:
  enabled: true
  # off | ads | ads+tracking | full
  level: ads
  extra_domains: []        # 额外屏蔽域名（追加到 hosts 之上）
  hosts_file: data/adblock/hosts
  auto_update: true        # 启动时若 hosts 缺失/过期自动拉取
  auto_update_interval_ms: 86400000   # 过期阈值 24h
  # 保白名单：这些域名即使命中黑名单也保留（防误杀）
  allowlist:
    - wikipedia.org
    - github.com
    - github.io
    - githubusercontent.com
    - stackoverflow.com
    - stackexchange.com
    - reddit.com
    - youtube.com
    - google.com
    - bing.com

fetch:
  timeout_ms: 15000
  max_bytes: 5242880       # 响应体上限 5MB
  user_agent: ""           # 空=默认 Chrome UA
  block_private_ips: true  # SSRF 防护
  private_ip_exempt_cidrs:  # 命中视为非私有（默认豁免 Clash fake-ip 段）
    - 198.18.0.0/15
    - fdfe:dcba:9876::/64
  structural: clean        # clean(默认去导航/广告) | full(保留完整结构)
  max_output_chars: 20000  # 输出 md 上限
  cache_ttl_ms: 600000     # fetch 结果缓存 10 分钟
  cache_max_entries: 200

browser:
  enabled: true            # 浏览器能力（fetch 路由③ + browser_* 工具）
  headless: true
  pool_size: 1             # 实例池上限
  idle_ttl_ms: 360000      # 空闲 360s 自动关闭（可配）
  timeout_ms: 30000
  max_concurrent: 2
  engine: chromium         # chromium | camoufox（camoufox 预留）
  proxy_server: ""         # 代理预留
  proxy_username: ""
  proxy_password: ""
  wait_for_selector: ""    # 渲染前等待该选择器（复杂 SPA）
  screenshot:
    enabled: true
    max_size: 512          # 截图最大边长像素（可配）
    image_type: jpeg

embedding:                 # 文本向量来源（外部服务），独立于 searxng
  enabled: false           # 关闭时：不召回、不语义重排，行为同旧版
  provider: openai         # openai（POST {base_url}/embeddings）| ollama（POST {base_url}/api/embed）
  base_url: http://127.0.0.1:11434/v1
  api_key: ""              # 建议用环境变量 EMBEDDING_API_KEY 注入
  model: BAAI/bge-m3
  dim: 0                   # 0=启动探针解析；>0 直接采用
  timeout_ms: 5000
  batch_size: 32
  concurrency: 4           # 单次 embed 内并发批次数上限（≥1，默认 4）
  max_input_chars: 2000
  # 非空则覆盖内置模型 profile（如 e5 需 query:/passage: 前缀）
  query_prefix: ""
  passage_prefix: ""

corpus:                    # 本地语料库（磁盘 sqlite-vec）；每次搜索恒开召回
  enabled: false
  store_path: data/corpus/corpus.db
  ttl_ms: 2592000000       # 30 天
  recall_k: 10             # KNN 召回上限（与上游按 URL 去重后进排序）
  sweep_interval_ms: 3600000
