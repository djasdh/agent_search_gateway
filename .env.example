# agent_search_gateway 环境变量（密钥覆盖）
#
# 复制为 .env 或直接 export。这些变量优先级高于 secrets.yaml，
# 因此凭据可以只放环境变量，不落盘。
#
# 空值 = 不覆盖：secrets.yaml / 默认值继续生效。

# MCP HTTP 传输的 Bearer token。留空 = 不认证；
# 除有真实鉴权前置，否则只把网关绑在 127.0.0.1。
GATEWAY_TOKEN=

# embedding 服务凭据（覆盖 secrets.yaml 的 embedding.api_key）。
EMBEDDING_API_KEY=

# SauceNAO API key（覆盖 secrets.yaml 的 search.reverse_image.saucenao.api_key）。
SAUCENAO_API_KEY=

# Bilibili HTTP 后端 Bearer token（覆盖 secrets.yaml 的 bilibili.http.token）。
BILIBILI_HTTP_TOKEN=

# 浏览器代理密码（覆盖 secrets.yaml 的 browser.proxy_password）。
BROWSER_PROXY_PASSWORD=
